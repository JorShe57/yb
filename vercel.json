{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "shared/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },

    { "src": "/webhook/quote", "methods": ["POST"], "dest": "/api/webhook/quote" },

    { "src": "/(.*)", "methods": ["GET", "HEAD"], "dest": "/index.html" }
  ]
}

