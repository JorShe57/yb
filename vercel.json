{
  "buildCommand": "npm run build",
  "version": 2,
  "builds": [
    { "src": "api/[...all].ts", "use": "@vercel/node" },
    { "src": "dist/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },

    { "src": "/webhook/quote", "methods": ["POST"], "dest": "/api/[...all].ts" },

    { "src": "/api/(.*)", "dest": "/api/[...all].ts" },

    { "src": "/(.*)", "methods": ["GET", "HEAD"], "dest": "/index.html" }
  ]
}

